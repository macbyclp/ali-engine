{
  "entities": [
    {
      "name": "floor",
      "transform": { "position": [0, 0, 0], "scale": [16, 1, 16] },
      "mesh": { "primitive": "plane", "base_color_map": "builtin:checker" }
    },
    {
      "name": "sun",
      "light": { "direction": [-0.4, -1.0, -0.3], "color": [1.0, 0.97, 0.9], "intensity": 1.3 }
    },
    {
      "name": "camera",
      "camera": { "position": [4, 3, 8], "target": [0, 2, 0], "fov_deg": 55 }
    },
    {
      "name": "actor",
      "transform": { "position": [0, 0, 0], "scale": [1, 2, 1] },
      "mesh": { "primitive": "skinned", "gltf_path": "builtin:bendbar", "base_color": [0.55, 0.7, 0.9] },
      "animator": {
        "entry": "idle",
        "states": [
          { "name": "idle", "clip": "idle", "speed": 1.0 },
          { "name": "wave", "clip": "wave", "speed": 1.2 },
          { "name": "bend", "clip": "bend", "loop": false }
        ],
        "transitions": [
          { "from": "idle", "to": "wave", "blend": 0.25, "when": [ { "param": "moving", "op": "==", "value": 1 } ] },
          { "from": "wave", "to": "idle", "blend": 0.25, "when": [ { "param": "moving", "op": "==", "value": 0 } ] },
          { "from": "*",    "to": "bend", "blend": 0.15, "when": [ { "param": "duck", "op": "trigger" } ] },
          { "from": "bend", "to": "idle", "blend": 0.3,  "exit_time": 0.9, "when": [] }
        ]
      }
    }
  ]
}
