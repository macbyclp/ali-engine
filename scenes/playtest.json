{
  "environment": { "ssao": true, "ssao_intensity": 1.3 },
  "input": {
    "fwd":   ["W", "Up"],
    "back":  ["S", "Down"],
    "left":  ["A", "Left"],
    "right": ["D", "Right"],
    "jump":  ["Space"]
  },
  "entities": [
    { "name": "sun", "light": { "type": "directional", "direction": [-0.4,-0.9,-0.35], "color": [1,0.96,0.88], "intensity": 1.25 } },
    { "name": "camera", "camera": { "position": [9,7,12], "target": [0,1,0], "fov_deg": 55 } },
    { "name": "ground", "transform": { "scale": [24,1,24] },
      "mesh": { "primitive": "plane", "base_color_map": "builtin:checker" },
      "body": { "type": "static" } },
    { "name": "arch", "transform": { "position": [-4,2,-3] },
      "mesh": { "primitive": "procedural", "base_color": [0.82,0.55,0.4], "roughness": 0.5,
        "build": [ {"shape":"box","size":[5,4,2]}, {"op":"subtract","shape":"cylinder","radius":1.6,"height":3,"rotate":[90,0,0]}, {"op":"subtract","shape":"box","size":[2.6,3,3],"translate":[0,-1.2,0]} ] } },
    { "name": "pillar", "transform": { "position": [3,1.5,2] },
      "mesh": { "primitive": "procedural", "base_color": [0.7,0.72,0.75], "metallic": 0.3,
        "build": [ {"shape":"cylinder","radius":0.5,"height":3,"segments":8} ] },
      "body": { "type": "static" } },
    { "name": "player", "transform": { "position": [0,1,4] },
      "mesh": { "primitive": "cube", "base_color": [0.35,0.62,0.95], "roughness": 0.3 },
      "body": { "type": "dynamic", "mass": 1, "friction": 0.9 },
      "behavior": [
        { "on": "input", "action": "fwd",   "do": [ { "action": "setVelocity", "velocity": [0,0,-5] } ] },
        { "on": "input", "action": "back",  "do": [ { "action": "setVelocity", "velocity": [0,0,5] } ] },
        { "on": "input", "action": "left",  "do": [ { "action": "setVelocity", "velocity": [-5,0,0] } ] },
        { "on": "input", "action": "right", "do": [ { "action": "setVelocity", "velocity": [5,0,0] } ] },
        { "on": "inputPressed", "action": "jump", "do": [ { "action": "impulse", "impulse": [0,6,0] } ] }
      ] },
    { "name": "goal", "transform": { "position": [-4,1.2,-3], "scale": [2,2,2] },
      "mesh": { "primitive": "cube", "base_color": [0.2,1,0.4], "emissive": [0.05,0.4,0.12] },
      "body": { "type": "kinematic", "sensor": true },
      "behavior": [
        { "on": "enter", "with": "player", "do": [ { "action": "log", "message": "GOAL REACHED" }, { "action": "setColor", "color": [1,0.9,0.2] } ] }
      ] }
  ]
}
