    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["ali-engine", "game-engine", "3d", "ai", "opengl"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/macbyclp/ali-engine.git", "directory": "clients/js" },
  "engines": { "node": ">=18" },
  "devDependencies": { "typescript": "^5.4.0", "@types/node": "^20.11.0" }
}
