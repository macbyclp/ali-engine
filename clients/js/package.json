{
  "name": "ali-engine-client",
  "version": "0.1.0",
  "description": "Drive the ali-engine AI-native 3D engine over its line-delimited JSON protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
